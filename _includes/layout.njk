<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} — jess boonekamp{% else %}{{ metadata.name }} — Dad, founding engineer and architect{% endif %}</title>
  <link rel="canonical" href="{{ metadata.url }}{{ page.url | encodeURI }}">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%23111'/><text x='50' y='68' font-size='55' font-family='Menlo,monospace' font-weight='bold' fill='%23fff' text-anchor='middle'>j</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap">
  <link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ metadata.name }}">
  <meta property="og:site_name" content="{{ metadata.name }}">
  <meta property="og:title" content="{{ title or metadata.name }}">
  <meta property="og:type" content="{% if page.url == "/" %}website{% else %}article{% endif %}">
  <meta property="og:url" content="{{ metadata.url }}{{ page.url | encodeURI }}">
  {%- set desc = description or metadata.description %}
  {% if desc %}<meta property="og:description" content="{{ desc }}">
  <meta name="description" content="{{ desc }}">{% endif %}
  {% if "/takes/" in page.url %}
  {%- set slug = page.url | replace("/takes/", "") | replace("/", "") %}
  <meta property="og:image" content="{{ metadata.url }}/og/{{ slug }}.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ title }}">
  <meta property="article:published_time" content="{{ date | isoDate }}">
  <meta property="article:author" content="{{ metadata.url }}">
  <meta name="twitter:card" content="summary_large_image">
  {% else %}
  <meta name="twitter:card" content="summary">
  {% endif %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "name": "jess boonekamp",
        "url": "{{ metadata.url }}",
        "feedUrl": "{{ metadata.url }}/feed.xml"
      },
      {
        "@id": "{{ metadata.url }}/#person",
        "@type": "Person",
        "name": "{{ metadata.author }}",
        "url": "{{ metadata.url }}",
        "jobTitle": "Founding engineer and architect",
        "description": "{{ metadata.description }}",
        "email": "mailto:{{ metadata.email }}",
        "sameAs": ["{{ metadata.socials.x }}", "{{ metadata.socials.github }}", "{{ metadata.socials.linkedin }}"]
      }{% if page.url == "/" %},
      {
        "@type": "ProfilePage",
        "url": "{{ metadata.url }}/",
        "mainEntity": { "@id": "{{ metadata.url }}/#person" }
      }{% endif %}{% if "/takes/" in page.url %},
      {
        "@type": "BlogPosting",
        "headline": "{{ title }}",
        "description": "{{ description }}",
        "url": "{{ metadata.url }}{{ page.url | encodeURI }}",
        "datePublished": "{{ date | isoDate }}",
        "dateModified": "{{ date | isoDate }}",
        "mainEntityOfPage": "{{ metadata.url }}{{ page.url | encodeURI }}",
        "image": "{{ metadata.url }}/og/{{ page.url | replace("/takes/", "") | replace("/", "") }}.png",
        "author": { "@type": "Person", "name": "{{ metadata.author }}", "url": "{{ metadata.url }}" },
        "publisher": { "@type": "Person", "name": "{{ metadata.author }}", "url": "{{ metadata.url }}" }
      }{% endif %}
    ]
  }
  </script>
  <style>
    body { max-width: 38em; margin: 1em auto; padding: 0 1em;
           font: 16px/1.7 "Space Grotesk", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
           -webkit-font-smoothing: antialiased; }
    code, pre { font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; }
    a { color: inherit; text-decoration-color: #999; }
    a:hover { text-decoration-color: inherit; }
    h1 { font-size: 1.35em; line-height: 1.3; margin: 1em 0 0.25em; }
    h2 { font-size: 1.05em; margin: 2.5em 0 0.5em; }
    p { margin: 1.1em 0; }
    blockquote { margin: 1.5em 0; padding: 0 1em; color: #555;
                 border-left: 3px solid #eee; }
    blockquote p { margin: 0.5em 0; }
    code { background: #f5f5f5; padding: 0.15em 0.35em; font-size: 0.9em; }
    img { max-width: 100%; height: auto; border-radius: 4px; }
    header { margin: 0 0 2em; }
    hr { border: none; border-top: 1px dashed #ccc; margin: 2em 0; }
    p.date { margin: 0 0 1.5em; }
    article { font-size: 17px; line-height: 1.75; letter-spacing: 0.01em; }
    article p { margin: 1.3em 0; }
    article h1 { font-size: 1.5em; letter-spacing: -0.01em; margin: 1em 0 0.25em; }
    .share { margin: 2.5em 0 0; font-size: 0.85em; color: #999; }
    .posts { list-style: none; padding: 0; margin: 1.5em 0; }
    .posts li { padding: 0.4em 0; display: flex; justify-content: space-between; align-items: baseline; gap: 1em; }
    .posts li a { flex: 1 1 auto; }
    .posts .meta { display: flex; gap: 0.6em; color: #999; font-size: 0.85em; white-space: nowrap; }
    .posts .date, .posts .read { color: #999; }
    footer { margin-top: 2em; font-size: 0.85em; }
    .intro { font-size: 1.05em; color: #555; margin-top: 0.3em; }
    .site-name { font-size: 1.1em; font-weight: 500; letter-spacing: 0.15em; margin-bottom: 0; }
    .track { list-style: none; padding: 0; margin: 1.5em 0; }
    .track li { display: grid; grid-template-columns: 110px 1fr; gap: 1em; padding: 0.6em 0; }
    .track-meta { color: #999; font-size: 0.9em; }
    .track-body strong { font-weight: 600; }
    .role { font-weight: 500; }
    .desc { color: #555; font-size: 0.95em; margin-top: 0.2em; }
    @media (max-width: 520px) {
      .track li { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
{% include "header.njk" %}
{{ content | safe }}
{% include "footer.njk" %}
</body>
</html>
